APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# Secrets below (passwords, subscription key, webhook secret) can be stored encrypted:
# run `php artisan secrets:encrypt` ON THE SERVER and paste the "enc:..." value.

# Core banking (web-abacus): loan inquiry + payment push
CORE_BANKING_API_BASE_URL=https://go.web-abacus.com
CORE_BANKING_INQUIRY_USERNAME=
CORE_BANKING_INQUIRY_PASSWORD=
CORE_BANKING_PAYMENT_USERNAME=
CORE_BANKING_PAYMENT_PASSWORD=
CORE_BANKING_SOURCE_CURRENCY_ID=3
CORE_BANKING_PUSH_ENABLED=true

# Areeba hosted checkout (payments-api.areeba.com)
AREEBA_BASE_URL=https://payments-api.areeba.com
AREEBA_ENV_PATH=prod
AREEBA_CLIENT_ID=2503
AREEBA_PRODUCT_ID=93000533
AREEBA_API_USERNAME="Vitas PGW"
AREEBA_API_PASSWORD=
AREEBA_SUBSCRIPTION_KEY=
AREEBA_CURRENCY=IQD
# set only if Areeba takes the return URL as a checkout parameter (otherwise configure
# https://<site>/payment/return on the Areeba portal)
AREEBA_RETURN_URL_PARAM=
AREEBA_WEBHOOK_SECRET=
AREEBA_WEBHOOK_SIGNATURE_HEADER=X-Signature
AREEBA_WEBHOOK_ALGO=sha256
AREEBA_LOYALTY_POINTS=150
PAYMENT_INQUIRY_RATE_LIMIT=15

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Firebase Cloud Messaging: service account JSON path relative to the project root (default storage/app/firebase/service-account.json)
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT_ID=
